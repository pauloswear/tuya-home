# Copie para .env e preencha. O .env NÃO é versionado (está no .gitignore).

# Histórico de energia: MySQL/MariaDB (se vazio, usa SQLite local em data/)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=tuya-dash

# API Cloud oficial da Tuya (agendamentos). Crie um projeto em platform.tuya.com.
# Western America = https://openapi.tuyaus.com
TUYA_CLOUD_ENDPOINT=https://openapi.tuyaus.com
TUYA_CLOUD_ACCESS_ID=
TUYA_CLOUD_SECRET=
